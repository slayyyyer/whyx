view:
<a class="act" href="/post?id={{it.id}}" title="Reply">
  <svg viewBox="0 0 24 24" width="18" height="18"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.5 9.7 9.7 0 0 1-3.8-.8L3 21l1.8-4.7A8.3 8.3 0 0 1 3.6 11.5a8.4 8.4 0 0 1 9-8.5 8.4 8.4 0 0 1 8.4 8.5z"/></svg>
  <span>{{it.replies}}</span>
</a>
<form class="act-form" method="post" action="/act">
  <input type="hidden" name="_token" value="{{csrf.token}}">
  <input type="hidden" name="action" value="repost">
  <input type="hidden" name="post_id" value="{{it.id}}">
  <input type="hidden" name="back" value="{{back}}">
  <button class="act repost{{#if it.reposted > 0}} on{{/if}}" type="submit" title="Repost">
    <svg viewBox="0 0 24 24" width="18" height="18"><path d="M17 2l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 22l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
    <span>{{it.reposts}}</span>
  </button>
</form>
<form class="act-form" method="post" action="/act">
  <input type="hidden" name="_token" value="{{csrf.token}}">
  <input type="hidden" name="action" value="like">
  <input type="hidden" name="post_id" value="{{it.id}}">
  <input type="hidden" name="back" value="{{back}}">
  <button class="act like{{#if it.liked > 0}} on{{/if}}" type="submit" title="Like">
    <svg viewBox="0 0 24 24" width="18" height="18"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l8.8 8.8 8.8-8.8a5.5 5.5 0 0 0 0-7.8z"/></svg>
    <span>{{it.likes}}</span>
  </button>
</form>
<a class="act" href="/post?id={{it.id}}" title="Open thread">
  <svg viewBox="0 0 24 24" width="18" height="18"><path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7"/><path d="M12 16V3"/><path d="M7 8l5-5 5 5"/></svg>
</a>
