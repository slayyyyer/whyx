imports:
_app
_authhead
_authtail

controller:
me = current_user(db, session)
if me
  redirect("/")
end
title = "Create account / whyx"
name = str(form.name)
handle = clean_handle(form.handle)
e_name = nil
e_handle = nil
e_password = nil
e_form = nil
if request.method == "POST"
  client = client_key(db, session)
  # Five accounts per browser inside the sign-in window, and the site ceiling caps the password
  # hashing a flood of cookie-less callers can cause. The attempt log is shared with sign-in, so
  # these limits survive a restart and need no extra table.
  browser_blocked = login_blocked(db, "signup", client, signup_limit())
  site_blocked = login_blocked(db, "site", "all", site_limit())
  if browser_blocked or site_blocked
    e_form = "Too many accounts from this browser. Wait a few minutes and try again."
  else
    fields = {name: form.name, handle: handle, password: form.password}
    errors = validate(fields, {name: "required,max:50", handle: "required,min:3,max:15", password: "required,min:6"})
    e_name = errors.name
    e_handle = errors.handle
    e_password = errors.password
    if e_name == nil and e_handle == nil and e_password == nil
      taken = db.get("select id from users where handle = ?", handle)
      if taken
        e_handle = "is already taken"
      else
        # The hash below is the expensive part, so it counts against the site ceiling first.
        login_failed(db, "site", "all")
        salt = db.query("select lower(hex(randomblob(16))) as s").first.s
        stored = "pbkdf2-sha256$" + str(rounds()) + "$" + salt + "$" + pbkdf2(str(form.password), salt, rounds())
        colors = ["#1d9bf0", "#f91880", "#00ba7c", "#ffd400", "#7856ff", "#ff7a00"]
        color = colors[db.query("select count(*) as n from users").first.n % 6]
        db.exec("insert into users (handle, name, bio, location, color, password_hash) values (?, ?, ?, ?, ?, ?)", handle, name.strip, "", "", color, stored)
        login_failed(db, "signup", client)
        created = db.get("select id from users where handle = ?", handle)
        session.clear()
        session.set("user_id", str(created.id))
        session.set("client", client)
        session.rotate()
        flash.set("notice", "Welcome to whyx, " + name.strip + ".")
        redirect("/")
      end
    end
  end
end

view:
{{> _authhead}}
<div class="auth-card">
  <a class="logo auth-logo" href="/">
    <svg viewBox="0 0 24 24" width="36" height="36" fill="currentColor"><path d="M23 4.9c-.8.4-1.7.7-2.6.8a4.5 4.5 0 0 0 2-2.5c-.9.5-1.9.9-3 1.1a4.5 4.5 0 0 0-7.7 4.1A12.8 12.8 0 0 1 2.4 3.6a4.5 4.5 0 0 0 1.4 6 4.4 4.4 0 0 1-2-.6v.1a4.5 4.5 0 0 0 3.6 4.4 4.5 4.5 0 0 1-2 .1 4.5 4.5 0 0 0 4.2 3.1A9 9 0 0 1 1 18.7a12.7 12.7 0 0 0 6.9 2c8.3 0 12.8-6.9 12.8-12.8v-.6c.9-.6 1.6-1.4 2.3-2.4z"/></svg>
  </a>
  <h1>Create your account</h1>
  {{#if e_form}}<p class="error">{{e_form}}</p>{{/if}}
  <form method="post" action="/signup">
    <input type="hidden" name="_token" value="{{csrf.token}}">
    <label>Name
      <input name="name" value="{{name}}" maxlength="50" autocomplete="name" placeholder="Ada Lovelace" required>
    </label>
    {{#if e_name}}<p class="error">{{e_name}}</p>{{/if}}
    <label>Handle
      <input name="handle" value="{{handle}}" maxlength="15" autocomplete="username" placeholder="ada" required>
    </label>
    {{#if e_handle}}<p class="error">{{e_handle}}</p>{{/if}}
    <label>Password
      <input type="password" name="password" autocomplete="new-password" required>
    </label>
    {{#if e_password}}<p class="error">{{e_password}}</p>{{/if}}
    <button class="btn primary wide" type="submit">Create account</button>
  </form>
  <p class="switch">Already here? <a href="/login">Sign in</a></p>
</div>
{{> _authtail}}
