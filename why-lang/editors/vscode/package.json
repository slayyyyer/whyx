{
  "name": "why-lang",
  "displayName": "Why",
  "description": "Syntax highlighting for Why pages.",
  "version": "0.1.0",
  "publisher": "slayyyyer",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/slayyyyer/why-lang"
  },
  "contributes": {
    "languages": [
      {
        "id": "why",
        "aliases": [
          "Why",
          "why"
        ],
        "extensions": [
          ".why"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "why",
        "scopeName": "source.why",
        "path": "./syntaxes/why.tmLanguage.json"
      }
    ]
  }
}
