imports:
header
footer

controller:
title = "Posts"
posts = db.query("select * from posts order by id desc limit 3")
count = posts.length

view:
{{> header}}
<h1>Latest posts</h1>
{{#if count > 0}}
{{#each posts}}
<article>
  <h2><a href="/post?id={{it.id}}">{{it.title}}</a></h2>
  <p class="meta">{{it.author}} · {{it.created_at}}</p>
  <p>{{it.body}}</p>
</article>
{{/each}}
{{else}}
<p>No posts yet.</p>
{{/if}}
{{> footer}}
